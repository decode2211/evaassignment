# None of these are required - the server has defaults for all of them.

# TCP port the server listens on.
PORT=8080

# Path to the SQLite database file. Parent directory is created if missing.
DB_PATH=./data/tickets.db

# Secret used to sign JWTs. Falls back to an insecure dev value with a
# warning if unset. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
