# Copy this file to ".env" and adjust values if you need to change any
# defaults. None of these are required - the server runs with sensible
# defaults for all of them, which is why the Docker image needs zero
# configuration to start.

# The TCP port the HTTP server listens on.
PORT=8080

# Where the SQLite database file is stored on disk. The containing
# directory is created automatically if it doesn't exist.
DB_PATH=./data/tickets.db

# Secret key used to sign and verify login tokens (JWTs). If this is not
# set, the server falls back to an insecure, publicly-known development
# value and logs a loud warning - fine for local testing, NOT fine for any
# real deployment. Set this to a long, random string in production, e.g.
# generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
